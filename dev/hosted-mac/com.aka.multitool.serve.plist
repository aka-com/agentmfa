<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- LaunchAgent (NOT a LaunchDaemon: the broker needs the login Keychain)
     that keeps a hosted Multitool broker running. Install at
     ~/Library/LaunchAgents/com.aka.multitool.serve.plist and edit the paths/URL. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.aka.multitool.serve</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/multitool</string>
    <string>serve</string>
    <string>--listen</string>
    <string>127.0.0.1:4780</string>
    <string>--public-url</string>
    <string>https://broker.example.dev</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/multitool-serve.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/multitool-serve.log</string>
</dict>
</plist>
