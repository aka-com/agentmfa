{
  "name": "multitool-desktop",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:release": "bash scripts/release.sh",
    "lint": "cargo clippy --workspace --all-targets",
    "start": "tauri dev",
    "frontend:dev": "vite",
    "frontend:build": "vite build",
    "typecheck": "tsc --noEmit",
    "sandbox:up": "bash scripts/sandbox-up.sh",
    "sandbox:status": "bash scripts/sandbox-status.sh",
    "sandbox:down": "bash scripts/sandbox-down.sh",
    "sandbox:reset": "bash scripts/sandbox-reset.sh",
    "sandbox:test": "bash scripts/sandbox-test.sh",
    "npm:sync": "node scripts/npm/sync-versions.mjs",
    "npm:check": "node scripts/npm/sync-versions.mjs --check",
    "npm:dist": "bash scripts/npm-dist.sh --all --pack",
    "npm:publish": "bash scripts/npm-publish.sh",
    "test": "pnpm run npm:check && pnpm run test:npm-launcher && pnpm run typecheck && cargo test --workspace && pnpm run test:ui",
    "test:npm-launcher": "node --test scripts/npm/launcher.test.mjs",
    "test:ui": "tsx --test ui/tests/*.test.ts ui/tests/*.test.tsx"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.4"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "jsqr": "^1.4.0",
    "lucide": "^1.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
