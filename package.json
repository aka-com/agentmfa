{
  "name": "aka-desktop",
  "private": true,
  "scripts": {
    "build": "bash scripts/build.sh",
    "start": "tauri dev",
    "frontend:dev": "vite",
    "frontend:build": "vite build",
    "sidecar:build": "vite build --config sidecar/vite.config.ts",
    "sidecar:vendor": "bash scripts/vendor-node.sh",
    "typecheck": "tsc --noEmit",
    "test:ui": "tsx --test ui/tests/*.test.ts",
    "sandbox:up": "bash scripts/sandbox-up.sh",
    "sandbox:status": "bash scripts/sandbox-status.sh",
    "sandbox:down": "bash scripts/sandbox-down.sh",
    "sandbox:reset": "bash scripts/sandbox-reset.sh",
    "release": "bash scripts/release.sh",
    "npm:sync": "node scripts/npm/sync-versions.mjs",
    "npm:check": "node scripts/npm/sync-versions.mjs --check",
    "test:npm-launcher": "node --test scripts/npm/launcher.test.mjs",
    "npm:dist": "bash scripts/npm-dist.sh --all --pack",
    "npm:publish": "bash scripts/npm-publish.sh",
    "test": "npm run npm:check && npm run test:npm-launcher && npm run typecheck && npm run sidecar:build && cargo test --workspace && cargo test --manifest-path src-tauri/Cargo.toml && npm run test:ui && npm run test:sidecar",
    "lint": "cargo clippy --workspace --all-targets && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets",
    "test:sidecar": "tsx --test sidecar/tests/*.test.ts"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.4"
  },
  "dependencies": {
    "@executor-js/plugin-mcp": "^1.5.35",
    "@executor-js/sdk": "^1.5.35",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "effect": "^4.0.0-beta.59",
    "lucide": "^1.23.0",
    "zod": "^4.4.3"
  }
}
