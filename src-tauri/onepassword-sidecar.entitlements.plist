<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    The 1Password SDK's service-account backend runs WebAssembly through
    wazero's compiler. The compiler writes native code into anonymous memory
    and then marks it executable, so macOS kills the signed helper under the
    hardened runtime unless this exception is present.
  -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
