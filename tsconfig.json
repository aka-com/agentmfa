{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "paths": {
      "/src/*": ["./ui/src/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"]
  },
  "include": ["ui/**/*.ts", "ui/**/*.tsx", "sidecar/**/*.ts", "scripts/**/*.ts", "vite.config.ts"],
  "exclude": ["dist", "node_modules", "ui/public"]
}
