{
  "name": "agentmfa",
  "version": "0.1.0",
  "description": "AgentMFA credential broker for coding agents, without exposing credentials.",
  "keywords": [
    "agentmfa",
    "mfa",
    "credentials",
    "secrets",
    "broker",
    "mcp",
    "ai-agents",
    "claude-code",
    "security",
    "ssh",
    "postgres",
    "proxy"
  ],
  "homepage": "https://github.com/aka-com/agentmfa",
  "bin": {
    "agentmfa": "bin/agentmfa.js",
    "mfa": "bin/agentmfa.js"
  },
  "files": [
    "bin/agentmfa.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepublishOnly": "node ../../scripts/npm/verify-package.mjs"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "optionalDependencies": {
    "agentmfa-darwin-arm64": "0.1.0",
    "agentmfa-darwin-x64": "0.1.0",
    "agentmfa-linux-arm64": "0.1.0",
    "agentmfa-linux-x64": "0.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
